NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/bard
MONGODB_DB_NAME=bard
SESSION_SECRET=replace-with-a-long-random-session-secret
CSRF_SECRET=replace-with-a-long-random-csrf-secret
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-your-cloudinary-api-secret
CLIENT_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@example.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM_NAME=Bard
EMAIL_FROM_ADDRESS=your-gmail-address@example.com
EMAIL_SEND_WELCOME=false
UPLOAD_DIR=uploads
# Optional: used only by `npm run seed`
SEED_DEMO=false
ADMIN_SEED_USERNAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
# Optional test overrides
# AUTH_RATE_MAX=20
# COMMENT_RATE_MAX=30
# UPLOAD_RATE_MAX=20
# REPORT_RATE_MAX=10
